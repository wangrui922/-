# Copy this file to .env.production on the server, then fill in real values.
# Do not commit or send the completed file.
JWT_SECRET=replace-with-a-long-random-secret
ARK_API_KEY=replace-with-your-server-side-ark-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260428
FREE_DAILY_AI=20
PUBLIC_BASE_URL=http://YOUR_SERVER_IP
CORS_ORIGINS=http://YOUR_SERVER_IP
SMS_PROVIDER=mock

# 腾讯云短信（仅 SMS_PROVIDER=tencent 时需要；申请入口：腾讯云控制台 -> 短信 -> 快速开始）
#   SECRET_ID/SECRET_KEY 为访问管理 CAM 生成的 API 密钥；SIGN_NAME/TEMPLATE_ID 需已审核通过
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SIGN_NAME=
SMS_TENCENT_TEMPLATE_ID=
SMS_TENCENT_ENDPOINT=sms.tencentcloudapi.com
SMS_TENCENT_REGION=ap-guangzhou
