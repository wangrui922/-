# ============================================================
# AI数学教练 V4.1 · 环境变量样例
# 复制为 .env 后按需修改：  copy .env.example .env
# 唯一的运行方式切换点 = DATABASE_URL
# ============================================================

# ---------- 应用 ----------
APP_NAME=ai-math-coach
APP_ENV=dev                 # dev / test / prod
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------- 数据库（二选一）----------
# A. Docker PostgreSQL 16 + pgvector（推荐，宿主机端口 5433）
# DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5433/coach
# B. SQLite 回退（本机无 Docker 也能开工）
DATABASE_URL=sqlite:///./dev.db
DB_ECHO=false

# docker-compose 用（容器内部仍是 5432）
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach
POSTGRES_DB=coach

# ---------- 鉴权 JWT（HS256）----------
JWT_SECRET=dev-secret-change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120      # 2h
REFRESH_TOKEN_EXPIRE_DAYS=30         # 30d

# ---------- 配额 / 限流（无 Redis，DB 计数）----------
# 内测期全免费不限额：0 或负数 = 不限流
FREE_DAILY_AI=0

# ---------- 模型网关（火山方舟，服务端持 Key，前端零感知）----------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-250615
ARK_TIMEOUT_SEC=60

# ---------- 存储 ----------
STORAGE_DRIVER=local        # local / cos
STORAGE_DIR=./storage

# ---------- 语音合成 TTS（可切换 provider，详见 docs/tts-provider-switch.md）----------
# edge  = 微软 Edge TTS（免 Key，内测期默认 + 最终兜底）
# volc  = 火山引擎豆包语音（默认 v3 = 语音合成模型 2.0，流式 NDJSON）
# piper = 本地离线兜底（尚未实现，选中会自动降级到 edge）
TTS_PROVIDER=edge
TTS_VOICE=                          # 留空用各 provider 默认嗓音
TTS_FALLBACK_ENABLED=true           # 主 provider 失败时自动降级到 edge
# 火山凭据：控制台「服务接口认证信息」申请，真实值只填在 .env 里，**不要提交进 git**
TTS_VOLC_APP_ID=
TTS_VOLC_ACCESS_TOKEN=              # ★ 语音应用独立 Token，与 ARK_API_KEY 不是一套，不可留空复用
TTS_VOLC_API_VERSION=v3             # v3 = 2.0 大模型（默认）；v1 = 经典小模型（回退用）
TTS_VOLC_RESOURCE_ID=seed-tts-2.0   # ★ 必须与音色所属资源匹配，2.0 音色固定此值
TTS_VOLC_BASE_URL=                  # 留空按 API_VERSION 自动选；也可填内网网关
TTS_VOLC_VOICE_TYPE=zh_female_vv_uranus_bigtts
TTS_VOLC_CLUSTER=volcano_tts        # 仅 v1 使用
TTS_VOLC_ENCODING=mp3
TTS_VOLC_TIMEOUT_SEC=15

# ---------- 短信（dev 环境万能码 000000）----------
SMS_PROVIDER=mock
DEV_SMS_CODE=000000
