{
  "name": "student-web",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "description": "AI数学教练 V4.1 学生端（Vue3 + Vite + TS + Tailwind）。启动：npm install && npm run dev",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "vue-tsc": "^2.1.6"
  }
}
